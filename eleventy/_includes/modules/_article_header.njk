{# Shared header block for the article and show layouts.

   Caller provides:
     entry              — frontmatter object (the page's `data` in Eleventy)
     title_html         — pre-rendered <h2>...</h2> for the title
     summaryAboveImage  — boolean: true for shows, false for segments.
     _audioTracks       — optional: show pages pass a list of {id,title} so the
                          player chapters by segment (set in show.njk).
#}
{% from "modules/audio-player.njk" import player with context %}
{{ title_html | safe }}
<p class="clr"></p>
<p><strong>Air Date: {{ entry.date | strftime('%B %d, %Y') }}</strong></p>

{# Discovery pills: speakers featured on this segment (≥3 archive appearances,
   so they have a /people/ page) and topical tags. Both link out to
   aggregate pages. Rendered up top so readers know what they're looking
   at before the transcript.

   The show layout pre-computes show-level aggregates (union across all
   its segments) and passes them in via _aggSpeakers / _aggTags — those
   take precedence when set. #}
{% set _src = page.inputPath | toContentRel %}
{% set _featured = _aggSpeakers or (_src | speakersForSegment) %}
{% set _tagList = _aggTags or tags %}
{% set _hasPills = (_tagList and _tagList.length) or (_featured and _featured.length) %}
{% if _hasPills %}
<style>
    .segment-pills { margin: 0.75em 0 1em; display: flex; flex-wrap: wrap; gap: 0.4em; align-items: center; }
    .segment-pills .pill-label { font-size: 0.8em; color: #666; margin-right: 0.25em; text-transform: uppercase; letter-spacing: 0.04em; }
    .segment-pills a { display: inline-block; padding: 0.15em 0.6em; border-radius: 999px; font-size: 0.85em; text-decoration: none; border: 1px solid #d5dcd2; }
    .segment-pills .pill-speaker { background: #f4eee0; color: #5a4a1f; border-color: #e2d6b3; }
    .segment-pills .pill-speaker:hover { background: #ece4cf; }
    .segment-pills .pill-tag { background: #eef1ed; color: #2a4a2a; }
    .segment-pills .pill-tag:hover { background: #dde6d8; }
    .segment-pills .pill-sep { width: 1px; height: 1.1em; background: #d0d4ce; margin: 0 0.2em; }
</style>
<div class="segment-pills">
    {% if _featured and _featured.length %}
    {% for s in _featured %}
    <a href="/people/{{ s.slug }}.html" class="pill-speaker">{{ s.name }}</a>
    {% endfor %}
    {% endif %}
    {% if (_featured and _featured.length) and (_tagList and _tagList.length) %}<span class="pill-sep"></span>{% endif %}
    {% if _tagList and _tagList.length %}
    {% for t in _tagList %}
    <a href="/tags/{{ t }}.html" class="pill-tag">{{ t }}</a>
    {% endfor %}
    {% endif %}
</div>
{% endif %}

{% if entry.banner_url or entry.image_url %}
{# JS sets .landscape or .portrait on this figure after the image loads.
   Landscape → full-width above summary. Portrait/square → float right, summary wraps. #}
<figure class="header-image-container" id="hdr-fig-{{ entry.megaphone_id or 'main' }}">
    <img class="header-image" id="hdr-img-{{ entry.megaphone_id or 'main' }}"
         src="{{ entry.banner_url or entry.image_url }}" alt="{{ entry.title }}" />
    <script>(function () { var img = document.currentScript.previousElementSibling; function done() { var fig = img.closest('figure'); if (img.naturalWidth && img.naturalHeight) { fig.classList.add(img.naturalWidth / img.naturalHeight > 1.2 ? 'landscape' : 'portrait') } else { fig.classList.add('landscape') } } if (img.complete) { done() } else { img.addEventListener('load', done) } })();</script>
    {% if entry.image_caption %}
    <figcaption>{{ entry.image_caption }}</figcaption>
    {% endif %}
</figure>
{% endif %}

{% if entry.summary %}
<p class="show-header-summary">{{ entry.summary }}</p>
{% endif %}

<br />
{% if _audioTracks and _audioTracks.length %}
{{ player(_audioTracks, false, entry.megaphone_id) }}
{% elif entry.start %}
{# Windowed segment: a slice of the parent show's full-episode file. The show
   (resolved by date) carries the full mp3 as its own megaphone_id. #}
{% set _show = entry.date | showForDate(collections.shows) %}
{% if _show and _show.data.megaphone_id %}
{{ player([{ full: _show.data.megaphone_id, start: (entry.start | tcToSeconds), dur: (entry.duration | tcToSeconds), title: entry.title, art: entry.image_url }], true, _show.data.megaphone_id) }}
{% elif entry.megaphone_id %}
{{ player([{ id: entry.megaphone_id, title: entry.title, art: entry.image_url }], true, entry.megaphone_id) }}
{% endif %}
{% elif entry.megaphone_id %}
{# Up-next radio queue: related segments that have their own audio. #}
{% set _related = page.inputPath | relatedForSegment %}
{% set _queue = [] %}
{% for r in _related %}{% if r.megaphoneId %}{% set _ = _queue.push({ id: r.megaphoneId, title: r.title, art: r.art }) %}{% endif %}{% endfor %}
{{ player([{ id: entry.megaphone_id, title: entry.title, art: entry.image_url }], true, entry.megaphone_id, _queue) }}
{% elif entry.audio_url %}
{# Not (yet) on Megaphone — loe.org serves a raw enclosure mp3 directly.
   See issue #167. #}
{{ player([{ src: entry.audio_url, title: entry.title, art: entry.image_url }], true) }}
{% endif %}

<div class="clr"></div>
